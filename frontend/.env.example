VITE_API_URL=http://localhost:8080

# EmailJS (https://www.emailjs.com) — free tier works fine for a portfolio contact form.
# 1. Create an account, add an Email Service (e.g. Gmail), copy its Service ID below.
# 2. Create an Email Template with variables: {{from_name}}, {{from_email}}, {{message}}.
# 3. Copy the Template ID and your account's Public Key (Account > General).
# Leave these blank to keep the contact form working without email delivery
# (messages will still be saved by the backend).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
